{
    "version": 2,
    "buildCommand": "pnpm run build",
    "installCommand": "pnpm install",
    "framework": "nextjs",
    "regions": ["iad1"],
    "builds": [{
        "src": "package.json",
        "use": "@vercel/next"
    }],
    "build": {
        "env": {
            "NODE_VERSION": "20"
        }
    },
    "git": {
        "deploymentEnabled": {
            "main": true,
            "dev": true,
            "feature/*": false
        }
    }
}