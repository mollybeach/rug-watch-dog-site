{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/app/*": [
        "app/*"
      ],
      "@/api/*": [
        "src/api/*"
      ],
      "@/app/api/*": [
        "app/api/*"
      ],
      "@/components/*": [
        "components/*"
      ],
      "@/contracts/*": [
        "contracts/*"
      ],
      "@/data-harversting/*": [
        "src/data-harversting/*"
      ],
      "@/data-processing/*": [
        "src/data-processing/*"
      ],
      "@/db/*": [
        "src/db/*"
      ],
      "@/dbschema/*": [
        "dbschema/*"
      ],
      "@/entities/*": [
        "src/db/entities/*"
      ],
      "@/lib/*": [
        "lib/*"
      ],
      "@/models/*": [
        "src/models/*"
      ],
      "@/src/*": [
        "src/*"
      ],
      "@/scripts/*": [
        "src/scripts/*"
      ],
      "@/services/*": [
        "src/services/*"
      ],
      "@/training/*": [
        "src/training/*"
      ],
      "@/types/*": [
        "types/*"
      ],
      "@/styles/*": [
        "styles/*"
      ],
      "@/ui/*": [
        "components/ui/*"
      ],
      "@/utils/*": [
        "src/utils/*"
      ],
      "@/vizualizations/*": [
        "app/vizualizations/*"
      ],
      "@/documentation/*": [
        "documentation/*"
      ],
      "@/node_modules/*": [
        "node_modules/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "types/**/*",
    "styles/**/*",
    "src/**/*",
    "dbschema/**/*",
    "src/training/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
  //"exclude": ["node_modules"]
}
