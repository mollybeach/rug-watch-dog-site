{
    "name": "rug-watch-dog",
    "version": "1.0.0",
    "description": "AI-powered cryptocurrency token analyzer for detecting potential rug pulls",
    "main": "dist/api/server.js",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "go": "next build && next dev",
        "export": "next export",
        "test-db": "pnpm tsc scripts/test-db.ts && pnpm node scripts/test-db.js",
        "check-db": "pnpm tsc scripts/check-db-access.ts && pnpm node scripts/check-db-access.js",
        "test": "jest -c src/tests/jest.config.ts src/tests",
        "test:watch": "jest --watch",
        "server-build": "tsc --noEmit --outDir dist",
        "server-start": "ts-node src/api/server.ts",
        "server-dev": "ts-node-dev --respawn --transpile-only src/api/server.ts",
        "server-watch": "tsc --watch",
        "server-scan": "ts-node-dev --transpile-only src/scripts/scan.ts",
        "server-add-tokens": "ts-node-dev --transpile-only src/data-harvesting/addTokens.ts",
        "server-scan-chain": "ts-node-dev --transpile-only src/data-harvesting/scan-chain.ts",
        "server-train": "ts-node-dev --transpile-only src/scripts/train.ts",
        "server-connect": "edgedb -I mollybeach/rug-watch-dog-db",
        "server-view-db": "ts-node-dev --transpile-only src/scripts/view/view-db.ts",
        "server-view-local-db": "ts-node-dev --transpile-only src/scripts/view/view-local-db.ts",
        "server-view-cloud-db": "ts-node-dev --transpile-only src/scripts/view/view-cloud-db.ts",
        "server-collect-data": "ts-node-dev --transpile-only src/scripts/collect-data.ts",
        "server-check-data": "ts-node-dev --transpile-only src/scripts/view/check-data.ts",
        "server-clean-db": "ts-node-dev --transpile-only src/scripts/delete/clean-db.ts",
        "server-delete-data": "ts-node-dev --transpile-only src/scripts/delete/delete-data.ts",
        "server-server-delete-cloud-data": "ts-node-dev --transpile-only src/scripts/delete/delete-cloud-data.ts",
        "server-server-delete-local-data": "ts-node-dev --transpile-only src/scripts/delete/delete-local-data.ts",
        "server-query-dserver-b": "ts-node-dev --transpile-only src/scripts/query-db.ts",
        "server-init-dbserver-": "ts-node src/scripts/init-db.ts",
        "server-seed-dbserver-": "ts-node src/scripts/seed-db.ts",
        "server-test": "jest",
        "server-test:watch": "jest --watch",
        "server-test-connect": "ts-node-dev --transpile-only src/scripts/test-connect.ts",
        "server-test:coverage": "jest --coverage",
        "server-lint": "eslint . --ext .ts",
        "server-lint:fix": "eslint . --ext .ts --fix",
        "server-generate-edgeql": "pnpm generate edgeql-js",
        "server-mg-cloud-gen": "edgedb migration create && edgedb migrate && edgedb migrate -I mollybeach/rug-watch-dog-db && pnpm generate edgeql-js && edgedb migrate -I mollybeach/rug-watch-dog-db && pnpm generate edgeql-js",
        "server-migrate:undo": "sequelize-cli db:migrate:undo",
        "server-seed": "ts-node src/scripts/seed-db.ts",
        "server-typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@jest/types": "^29.6.3",
        "@tensorflow/tfjs-node": "^4.22.0",
        "@types/sequelize": "^4.28.20",
        "axios": "^1.5.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "edgedb": "^1.5.12",
        "ethers": "^6.7.1",
        "express": "^4.21.2",
        "ioredis": "^5.4.2",
        "p-limit": "^6.2.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.20",
        "@ethersproject/providers": "^5.7.2",
        "@jest/globals": "^29.7.0",
        "@metamask/providers": "^13.0.0",
        "@openzeppelin/contracts": "4.9.0",
        "@radix-ui/react-dialog": "^1.1.2",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.0.2",
        "@radix-ui/react-tabs": "^1.1.1",
        "@radix-ui/react-toast": "^1.2.2",
        "@types/cors": "^2.8.17",
        "@types/node": "^20.17.6",
        "@types/plotly.js-dist-min": "^2.3.4",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/react-plotly.js": "^2.6.3",
        "ajv": "^8.17.1",
        "assert": "^2.0.0",
        "autoprefixer": "^10.4.20",
        "browserify-zlib": "^0.2.0",
        "class-variance-authority": "0.7.0",
        "clsx": "^2.1.0",
        "cmdk": "^0.2.1",
        "critters": "^0.0.20",
        "crypto-browserify": "^3.12.0",
        "csv-parser": "^3.1.0",
        "d3-force": "3.0.0",
        "eslint": "^8.56.0",
        "eslint-config-next": "14.1.0",
        "https-browserify": "^1.0.0",
        "kubo-rpc-client": "^2.0.0",
        "lucide-react": "^0.471.0",
        "next": "14.1.0",
        "next-themes": "^0.4.3",
        "node-fetch": "^3.3.2",
        "os-browserify": "^0.3.0",
        "path-browserify": "^1.0.1",
        "plotly.js-dist-min": "^2.35.3",
        "postcss": "^8.4.49",
        "process": "^0.11.10",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-force-graph": "1.43.2",
        "react-plotly.js": "^2.6.0",
        "stream-browserify": "^3.0.0",
        "stream-http": "^3.2.0",
        "tailwind-merge": "^2.5.4",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.7.3",
        "url": "^0.11.0",
        "web3": "1.7.0"
    },
    "devDependencies": {
        "@edgedb/generate": "^0.5.6",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.5",
        "@types/node": "^20.17.14",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.7.0",
        "@typescript-eslint/parser": "^6.7.0",
        "eslint": "^8.49.0",
        "jest": "^29.7.0",
        "sequelize-cli": "^6.6.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.3",
        "@babel/core": "^7.26.0",
        "@babel/eslint-parser": "^7.26.5",
        "@babel/preset-env": "^7.26.0",
        "@babel/preset-react": "^7.26.3",
        "@babel/preset-typescript": "^7.26.0",
        "@cloudflare/next-on-pages": "^1.13.5",
        "@nomiclabs/hardhat-ethers": "^2.2.3",
        "@nomiclabs/hardhat-waffle": "^2.0.5",
        "@openzeppelin/hardhat-upgrades": "^1.22.1",
        "@types/ajv": "^1.0.4",
        "@types/d3-force": "^3.0.10",
        "babel-plugin-transform-runtime": "^6.23.0",
        "babel-preset-next": "^1.4.0",
        "chai": "^4.3.7",
        "dotenv": "^16.4.7",
        "ethereum-waffle": "^4.0.10",
        "hardhat": "^2.17.0",
        "wrangler": "^3.87.0"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yourusername/rug-watch-dog.git"
    },
    "keywords": [
