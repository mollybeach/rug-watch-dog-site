{
    "name": "rug-watch-dog",
    "version": "1.0.0",
    "description": "AI-powered cryptocurrency token analyzer for detecting potential rug pulls",
    "main": "dist/api/server.js",
    "scripts": {
        "build": "tsc",
        "start": "ts-node src/api/server.ts",
        "dev": "ts-node-dev --respawn --transpile-only src/api/server.ts",
        "watch": "tsc --watch",
        "scan": "ts-node-dev --transpile-only src/scripts/scan.ts",
        "train": "ts-node-dev --transpile-only src/scripts/train.ts",
        "connect": "edgedb -I mollybeach/rug-watch-dog-db",
        "view-data": "ts-node-dev --transpile-only src/scripts/view-db.ts",
        "view-local-data": "ts-node-dev --transpile-only src/scripts/view-local-db.ts",
        "collect-data": "ts-node-dev --transpile-only src/scripts/collect-data.ts",
        "check-data": "ts-node-dev --transpile-only src/scripts/check-data.ts",
        "clean-db": "ts-node-dev --transpile-only src/scripts/clean-db.ts",
        "delete-db": "ts-node-dev --transpile-only src/scripts/delete-data.ts",
        "delete-local-db": "ts-node-dev --transpile-only src/scripts/delete-local-data.ts",
        "init-db": "ts-node src/scripts/init-db.ts",
        "seed-db": "ts-node src/scripts/seed-db.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test-connect": "ts-node-dev --transpile-only src/scripts/test-connect.ts",
        "test:coverage": "jest --coverage",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "generate-edgeql": "pnpm generate edgeql-js",
        "mig-cloud-gen": "edgedb migration create && edgedb migrate && edgedb migrate -I mollybeach/rug-watch-dog-db && pnpm generate edgeql-js && edgedb migrate -I mollybeach/rug-watch-dog-db && pnpm generate edgeql-js",
        "migrate:undo": "sequelize-cli db:migrate:undo",
        "seed": "ts-node src/scripts/seed-db.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@jest/types": "^29.6.3",
        "@tensorflow/tfjs-node": "^4.11.0",
        "@types/sequelize": "^4.28.20",
        "axios": "^1.5.0",
        "dotenv": "^16.3.1",
        "edgedb": "^1.5.12",
        "ethers": "^6.7.1",
        "express": "^4.21.2",
        "ioredis": "^5.4.2",
        "p-limit": "^6.2.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@edgedb/generate": "^0.5.6",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.5",
        "@types/node": "^20.17.14",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^2.0.12",
        "@typescript-eslint/eslint-plugin": "^6.7.0",
        "@typescript-eslint/parser": "^6.7.0",
        "eslint": "^8.49.0",
        "jest": "^29.7.0",
        "sequelize-cli": "^6.6.1",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.3"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yourusername/rug-watch-dog.git"
    },
    "keywords": [
        "cryptocurrency",
        "blockchain",
        "machine-learning",
        "security",
        "ethereum"
    ],
    "author": "Your Name",
    "license": "MIT"
}